{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/desktop",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "sourceMap": false,
    "declaration": false,
    "importHelpers": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts"]
}
