# The server's settings (docs/deploy.md). Copy to .env next to compose.yml and fill in.
# All app variables: libs/api/core/src/lib/config/env.ts

# The address of the dashboard; its DNS A record must point to this server
DOMAIN=dash.example.com

# Generate each secret: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
# The SAME as on your computer: synced integration tokens are encrypted with it
ENCRYPTION_KEY=

APP_TIMEZONE=Europe/Warsaw
DEFAULT_LOCALE=ru

# Sync with your computer (docs/sync.md). The server starts with an empty database:
# your user and data arrive with the first sync, so do not set ADMIN_EMAIL here.
SYNC_MODE=server
# The same token as on your computer
SYNC_TOKEN=

# The Telegram bot, the Spotify app and LanguageTool are set in Settings > Integrations.

# The image to run; deploy.sh sets it. From GHCR: `…:main` follows the main branch,
# a version like `…:0.2.0` pins a release.
IMAGE=ghcr.io/romanrostislavovich/personal-dashboard:main
# How many daily database dumps to keep in ./backups
BACKUP_KEEP_DAYS=14
