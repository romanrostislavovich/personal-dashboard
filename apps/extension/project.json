{
  "name": "extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/extension/src",
  "projectType": "application",
  "tags": ["scope:extension", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/extension"],
      "options": {
        "commands": [
          "tsc -p apps/extension/tsconfig.json --noEmit",
          "node apps/extension/build.mjs"
        ],
        "parallel": false
      }
    }
  }
}
