{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "timezone": "Europe/Warsaw",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Minor and patch updates of everything else, one PR a week",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "matchPackageNames": ["*"]
    },
    {
      "description": "Angular moves together: the framework, its CLI, Material, the CDK",
      "matchPackageNames": ["@angular/**", "@angular-devkit/**", "@schematics/angular"],
      "groupName": "Angular"
    },
    {
      "description": "Nx and its plugins only work at one version",
      "matchPackageNames": ["nx", "@nx/**"],
      "groupName": "Nx"
    },
    {
      "description": "NestJS packages move together",
      "matchPackageNames": ["@nestjs/**"],
      "groupName": "NestJS"
    },
    {
      "description": "Electron and the packaging of the desktop app",
      "matchPackageNames": ["electron", "electron-builder"],
      "groupName": "Electron"
    },
    {
      "description": "Node follows the LTS that the Dockerfile and CI use",
      "matchDepNames": ["node"],
      "allowedVersions": "/^\d*[02468]\./"
    },
    {
      "description": "The GitHub Actions of the workflows",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  }
}
