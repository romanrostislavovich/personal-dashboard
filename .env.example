# Скопируй в .env и заполни. Описание всех переменных: libs/api/core/src/lib/config/env.ts

API_PORT=3300
# Порт Postgres на хосте для docker compose (по умолчанию 5432)
DB_PORT=5432
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard

# Минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars

# Ключ шифрования токенов интеграций в БД (минимум 32 символа). Сгенерировать так же, как JWT_SECRET.
# Не теряй: без него сохранённые токены (GitHub и т.д.) не расшифровать.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# В этом часовом поясе срабатывают ежедневные задачи (напоминания в 09:00, списания в 08:00)
APP_TIMEZONE=Europe/Warsaw

# Первый пользователь, создаётся при первом запуске
ADMIN_EMAIL=me@example.com
ADMIN_PASSWORD=change-me-please

# Токен бота от @BotFather. Пусто — Telegram-уведомления выключены
TELEGRAM_BOT_TOKEN=

# Путь к собранному фронтенду; в Docker задаётся автоматически
# WEB_DIST_PATH=dist/apps/web/browser
