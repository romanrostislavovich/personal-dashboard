import {z} from 'zod';

// The <%= titleEn %> module: its requests and responses (see libs/modules/<%= fileName %>).

export const <%= propertyName %>ItemInputSchema = z.object({
  name: z.string().trim().min(1).max(200),
});
export type <%= className %>ItemInput = z.infer<typeof <%= propertyName %>ItemInputSchema>;

/** One item of the list. */
export interface <%= className %>Item {
  id: string;
  name: string;
  createdAt: string;
}
