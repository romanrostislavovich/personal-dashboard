# Copy to .env and fill in. All variables are described in libs/api/core/src/lib/config/env.ts

API_PORT=3300
# Host port of PostgreSQL for docker compose (default 5432)
DB_PORT=5432
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start with the placeholders below: they are public.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars

# Encryption key for integration tokens stored in the DB (at least 32 characters). Generate like JWT_SECRET.
# Keep it safe: without it, saved tokens (GitHub, etc.) cannot be decrypted.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Daily jobs run in this time zone (reminders at 09:00, recurring payments at 08:00)
APP_TIMEZONE=Europe/Warsaw

# Allow new users to sign up (off by default — a self-hosted dashboard is usually personal)
ALLOW_REGISTRATION=false
# May a monitored site, a shop's page or an AI endpoint be a private or local address
# (127.0.0.1, 192.168.*)? Unset: yes while registration is closed, no once it is open —
# otherwise other users could reach the server's own network.
# ALLOW_PRIVATE_URLS=true
# Language of the first user: en or ru
DEFAULT_LOCALE=en

# The first user, created on the first start (the placeholder password is refused too)
ADMIN_EMAIL=me@example.com
ADMIN_PASSWORD=change-me-please

# Bot token from @BotFather. Empty — Telegram notifications are disabled
TELEGRAM_BOT_TOKEN=

# URL where the dashboard is opened (used by OAuth integrations). In development — the web dev server.
# Spotify does not accept localhost, hence 127.0.0.1.
PUBLIC_URL=http://127.0.0.1:4200

# Spotify (optional): an app at developer.spotify.com,
# its Redirect URI = PUBLIC_URL + /api/music/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Sync between your computer and a server (see docs/sync.md): off | server | client
SYNC_MODE=off
# The same on both instances, at least 32 characters. Generate like JWT_SECRET.
SYNC_TOKEN=
# Client only: the server address
SYNC_SERVER_URL=
# SYNC_INTERVAL_SECONDS=60
# SYNC_PEER_NAME=home-pc

# Path to the built frontend; set automatically in Docker
# WEB_DIST_PATH=dist/apps/web/browser
