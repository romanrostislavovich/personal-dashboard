<?xml version="1.0" encoding="utf-8"?>
<!-- The gentle day on the home screen (GentleWidget): a title and up to three small steps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gentle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gentle_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/gentle_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E6E1E5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gentle_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4dp"
        android:textColor="#CAC4D0"
        android:textSize="14sp" />
</LinearLayout>
