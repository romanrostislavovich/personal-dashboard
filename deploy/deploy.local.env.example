# Copy to deploy.local.env (not committed) for deploy/deploy.sh.
DEPLOY_HOST=root@1.2.3.4
DEPLOY_DOMAIN=dash.example.com
# The SSH key that logs in to the server
DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519
# The image CI publishes (the server pulls `sha-<commit>` of it) and how long to wait for it
# before building the image here.
# CI_IMAGE=ghcr.io/romanrostislavovich/personal-dashboard
# CI_WAIT_MINUTES=25
# The Android app (Settings → Apps) is signed with deploy/mobile-release.keystore; this is its
# password. Make both once and keep them (an update signed with another key does not install):
#   keytool -genkeypair -keystore deploy/mobile-release.keystore -alias dashboard -keyalg RSA \
#     -keysize 4096 -validity 10000 -storetype PKCS12 -dname "CN=Personal Dashboard"
# Without them deploy.sh builds no Android app.
# MOBILE_KEYSTORE_PASSWORD=
