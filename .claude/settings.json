{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-file.mjs",
            "timeout": 180,
            "statusMessage": "prettier + eslint on the edited file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node .claude/hooks/lint-before-commit.mjs",
            "timeout": 900,
            "statusMessage": "lint of the staged files before the commit"
          }
        ]
      }
    ]
  }
}
